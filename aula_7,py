planetas = ['Mercúrio', 'Vênus', 'Terra', 'Marte', 'Jupiter', 'Saturno', 'Urano', 'Netuno']

for planeta in planetas:
    for i in range(len(planetas)):       
        print(f'Planeta {i} = {planeta}')

for i, planeta in enumerate(planetas, start=1):
    print(f'Planeta {i}: {planeta}')       

for i in range(len(planetas)):
    print(f'Planeta {i+1}: {planetas[i]}')

i = 0
while i < len(planetas):
    print(f'Planeta: {i+1}')
    print(i, end="" ) 
    i += 1
